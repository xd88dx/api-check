{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "outDir": "server/dist",
    "rootDir": "server",
    "types": ["node", "vitest/globals"]
  },
  "include": ["server/**/*.ts"],
  "exclude": ["node_modules", "server/dist", "web"]
}
